<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Green Themed Login Page</title>

    <!-- Google Fonts for better typography -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <style>


        </style>
</head>
<body>
    <div class = "login-wrapper">
    <div class="login-container">
        <h1>Login</h1>
        <form method="post" action="try">
            <!-- Username input -->
            <input type="text" name="gmail"  placeholder="Gmail" class="login-input" required>
            
            <!-- Password input -->
            <input type="password" name="password"  placeholder="Password" class="login-input" required><br>
            
            <!-- Login button -->
            <button type="submit" class="login-button">Login</button>
        </form>

      
    </div>
    </div>
</body>
</html>