            } else {
                // If the map is hidden, remove hide-complete and apply the show animation
                console.log("great");
                result = await changeView(animal);
                console.log(result);

                popup.classList.remove('hide-complete');
                popup.classList.add('show');
            }*/
    }

    function getCoord(e)
    {
        var coord = e.latlng;
        var lat = coord.lat;
        var lng = coord.lng;
        console.log(lat + "," + lng);
    }
    </script>
</head>
